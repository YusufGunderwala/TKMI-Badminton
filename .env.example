# TKMI Badminton Tournament — Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit .env to Git — add it to .gitignore

# Supabase PostgreSQL connection
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-supabase-database-password

# OR use the full connection URL (Railway sets this automatically)
# DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# App
APP_ENV=production
APP_DEBUG=false
